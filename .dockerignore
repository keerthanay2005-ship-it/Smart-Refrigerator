# ── Version control ──────────────────────────────────────────
.git
.gitignore
.vscode

# ── Python cache & bytecode ──────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Virtual environments ──────────────────────────────────────
venv/
env/
.venv/
.env.local
.env.production

# ── Database files (mounted as Docker volume) ─────────────────
*.db
*.sqlite
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────
*.log
server.log
logs/

# ── Trained ML model files ────────────────────────────────────
models/

