# Active database backend: 'mock', 'sqlite', 'mongodb', or 'supabase'
DB_BACKEND=sqlite

# Flask secret key (change this to a strong random value in production)
SECRET_KEY=smart-fridge-super-secret-key-2024

# SQLite DB path (used inside Docker container)
SQLITE_DB_PATH=/app/data/smart_fridge.db

# Supabase REST configuration (only needed if DB_BACKEND=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key
